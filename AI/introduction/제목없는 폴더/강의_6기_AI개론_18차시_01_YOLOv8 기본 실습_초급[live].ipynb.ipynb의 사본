s":[{"output_type":"stream","name":"stdout","text":["Counter({'person': 3, 'bus': 1})\n","bus:1개(평균 confidence: 0.873)\n","person:3개(평균 confidence: 0.848)\n","Counter({'person': 2})\n","person:2개(평균 confidence: 0.827)\n","Counter({'dog': 1})\n","dog:1개(평균 confidence: 0.754)\n","검출된 객체 없음\n"]}]},{"cell_type":"code","source":["# 커스텀 시각화\n","\n","\n","def draw_custom_boxes(image, results, conf_threshold=0.5):\n","    \"\"\"커스텀 박스 그리기\"\"\"\n","    img_np = np.array(image).copy()\n","    boxes = results[0].boxes\n","\n","\n","    # 색상 팔레트 (클래스별)\n","    np.random.seed(42)\n","    colors = {cls: tuple(np.random.randint(0, 255, 3).tolist())\n","              for cls in range(len(class_names))}\n","\n","\n","    for box in boxes:\n","        conf = box.conf[0].cpu().item()\n","        if conf < conf_threshold:\n","            continue\n","\n","\n","        # 박스 정보\n","        x1, y1, x2, y2 = box.xyxy[0].cpu().numpy().astype(int)\n","        cls = int(box.cls[0].cpu().item())\n","        class_name = class_names[cls]\n","        color = colors[cls]\n","\n","\n","        # 박스 그리기\n","        cv2.rectangle(img_np, (x1, y1), (x2, y2), color, 3)\n","\n","\n","        # 레이블 배경\n","        label = f'{class_name} {conf:.2f}'\n","        (text_w, text_h), _ = cv2.getTextSize(\n","            label, cv2.FONT_HERSHEY_SIMPLEX, 0.7, 2)\n","        cv2.rectangle(img_np, (x1, y1 - text_h - 10),\n","                     (x1 + text_w, y1), color, -1)\n","\n","\n","        # 레이블 텍스트\n","        cv2.putText(img_np, label, (x1, y1 - 5),\n","                   cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)\n","\n","\n","    return img_np\n","\n","\n","# 커스텀 시각화 적용\n","img_name = list(images.keys())[0]\n","test_img = images[img_name]\n","results = model(test_img)\n","\n","\n","custom_img = draw_custom_boxes(test_img, results, conf_threshold=0.5)\n","\n","\n","fig, axes = plt.subplots(1, 2, figsize=(16, 8))\n","axes[0].imshow(test_img)\n","axes[0].set_title('Original Image', fontsize=14, fontweight='bold')\n","axes[0].axis('off')\n","\n","\n","axes[1].imshow(custom_img)\n","axes[1].set_title('Custom Visualization', fontsize=14, fontweight='bold')\n","axes[1].axis('off')\n","\n","\n","plt.tight_layout()\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":578},"id":"pzAHweRAYqsU","executionInfo":{"status":"ok","timestamp":1763358979884,"user_tz":-540,"elapsed":703,"user":{"displayName":"김다봄","userId":"02209919459503367304"}},"outputId":"c366840f-a5a4-41b0-cdfc-d712a768c036"},"execution_count":60,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","0: 640x480 4 persons, 1 bus, 1 stop sign, 10.2ms\n","Speed: 3.0ms preprocess, 10.2ms inference, 3.3ms postprocess per image at shape (1, 3, 640, 480)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x800 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["\n","# 모델 정보 및 성능 비교\n","\n","\n","model_info = {\n","    'YOLOv8n': {'params': '3.2M', 'mAP': 37.3, 'speed': '80+ FPS'},\n","    'YOLOv8s': {'params': '11.2M', 'mAP': 44.9, 'speed': '50+ FPS'},\n","    'YOLOv8m': {'params': '25.9M', 'mAP': 50.2, 'speed': '30+ FPS'},\n","    'YOLOv8l': {'params': '43.7M', 'mAP': 52.9, 'speed': '20+ FPS'},\n","    'YOLOv8x': {'params': '68.2M', 'mAP': 53.9, 'speed': '15+ FPS'},\n","}\n","\n","\n","print(\"\\n| 모델 | 파라미터 | mAP@0.5:0.95 | 속도 (T4 GPU) |\")\n","print(\"|------|----------|--------------|---------------|\")\n","for model_name, info in model_info.items():\n","    print(f\"| {model_name} | {info['params']} | {info['mAP']}% | {info['speed']} |\")\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2oec72aAZuOv","executionInfo":{"status":"ok","timestamp":1763359254745,"user_tz":-540,"elapsed":18,"user":{"displayName":"김다봄","userId":"02209919459503367304"}},"outputId":"be788094-0a08-48c5-abbc-1a663fd541a8"},"execution_count":61,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","| 모델 | 파